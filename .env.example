# Turso/libSQL (recommended for hosted SQLite)
# Copy the two values from your Turso database settings.
TURSO_DATABASE_URL=libsql://your-database-your-org.aws-us-east-1.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional legacy SQLAlchemy connection URL.
# Used only when both TURSO_DATABASE_URL and TURSO_AUTH_TOKEN are unset.
DATABASE_URL=

# MySQL fallback (used only when Turso credentials and DATABASE_URL are unset)
DB_HOST=localhost
DB_PORT=3306
DB_USER=campusguard
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=campusguard

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-at-least-32-random-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
