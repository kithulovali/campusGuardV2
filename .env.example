# Turso/libSQL (recommended for hosted SQLite)
# Create a database token in Turso and keep it secret.
# SQLAlchemy URL format:
# sqlite+libsql://campusguard-kithulovali.aws-us-east-2.turso.io?secure=true&authToken=YOUR_TURSO_AUTH_TOKEN
DATABASE_URL=

# MySQL fallback (used only when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=3306
DB_USER=campusguard
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=campusguard

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-at-least-32-random-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
